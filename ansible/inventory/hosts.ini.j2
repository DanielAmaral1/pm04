[app]
{{ app_public_ip }} ansible_user=ubuntu

[db]
{{ db_private_ip }} ansible_user=ubuntu ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -W %h:%p -i {{ ssh_key_path }} ubuntu@{{ app_public_ip }}"'

[all:vars]
ansible_ssh_private_key_file={{ ssh_key_path }}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
