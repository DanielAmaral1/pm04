services:
  api:
    image: "{{ backend_image }}"
    container_name: pm04-api
    restart: unless-stopped
    environment:
      MONGO_URI: "mongodb://{{ mongo_app_user }}:{{ mongo_app_password }}@{{ db_private_ip }}:27017/{{ mongo_app_database }}"
      CORS_ORIGIN: "https://{{ app_domain }}"
      PORT: "5000"
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://localhost:5000/health', r => process.exit(r.statusCode===200?0:1)).on('error', () => process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s

  nginx:
    image: "{{ frontend_image }}"
    container_name: pm04-nginx
    restart: unless-stopped
    depends_on:
      - api
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost/"]
      interval: 10s
      timeout: 5s
      retries: 5

  caddy:
    image: "caddy:{{ caddy_version }}"
    container_name: pm04-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/pm04/app/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - nginx

volumes:
  caddy_data:
    name: pm04_caddy_data
  caddy_config:
    name: pm04_caddy_config
