// Executado automaticamente pelo entrypoint do Mongo SOMENTE na primeira
// inicializacao do volume (dados ja existentes nao sao afetados/apagados).
db = db.getSiblingDB('{{ mongo_app_database }}');

db.createUser({
  user: '{{ mongo_app_user }}',
  pwd: '{{ mongo_app_password }}',
  roles: [{ role: 'readWrite', db: '{{ mongo_app_database }}' }],
});

db.createCollection('todos');

db.todos.insertMany([
  { text: 'Bem-vindo ao ToDo App da Feira de Profissoes', completed: false },
  { text: 'Dados de demonstracao - reinicie a lista antes de cada apresentacao', completed: false },
  { text: 'Estudar Cloud', completed: true },
]);
