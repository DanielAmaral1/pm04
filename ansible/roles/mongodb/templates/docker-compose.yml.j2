services:
  mongo:
    image: "mongo:{{ mongo_version }}"
    container_name: mongo-pm04
    restart: unless-stopped
    command: ["--wiredTigerCacheSizeGB", "{{ mongo_cache_size_gb }}", "--bind_ip_all"]
    environment:
      MONGO_INITDB_ROOT_USERNAME: "{{ mongo_root_user }}"
      MONGO_INITDB_ROOT_PASSWORD: "{{ mongo_root_password }}"
      MONGO_INITDB_DATABASE: "{{ mongo_app_database }}"
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
      - /opt/pm04/mongo/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

volumes:
  mongo_data:
    name: pm04_mongo_data
